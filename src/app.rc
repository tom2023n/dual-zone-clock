#include "resource.h"

1 24 "app.manifest"

IDI_APP ICON "../assets/app.ico"
IDR_FONT RCDATA "../assets/fonts/NotoSansSC-Medium.otf"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "DualZoneClock"
            VALUE "FileDescription", "Dual Zone Desktop Clock"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "DualZoneClock"
            VALUE "OriginalFilename", "DualZoneClock.exe"
            VALUE "ProductName", "Dual Zone Clock"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
